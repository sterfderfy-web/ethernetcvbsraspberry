#!/bin/bash
set -euo pipefail
# systemd also invokes ExecStop after a clean unsupported-firmware exit.
patch_pid=${1:-${MAINPID:-}}
[[ $patch_pid =~ ^[0-9]+$ ]] || exit 0
touch /run/cvbs-patch.stop
# ExecStop waits for verified rollback before systemd can send termination.
for attempt in $(seq 1 25); do
    if ! kill -0 "$patch_pid" 2>/dev/null; then exit 0; fi
    sleep 1
done
echo 'Patch rollback did not finish within 25 seconds' >&2
exit 1
